APP_ENV=production
APP_DEBUG=0
APP_URL=https://YOUR-DOMAIN.example/trader
APP_TOKEN=GENERATE_A_RANDOM_64_CHAR_TOKEN
SQLITE_PATH=/home/YOUR_CPANEL_USER/public_html/trader/data/signals.sqlite
