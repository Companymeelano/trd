Options -Indexes
<FilesMatch "^\.env(?:\..*)?$">
  Require all denied
</FilesMatch>
<FilesMatch "^(config|market|indicators|decision|check)\.php$">
  Require all denied
</FilesMatch>
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.php [QSA,L]
